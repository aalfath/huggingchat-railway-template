{
	admin off
	auto_https off
	persist_config off
	log {
		output stdout
		level WARN
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$CADDY_PORT} {
	# Never trust a user header sent by the client.
	request_header -X-Auth-User

	# Health check for Railway, no password.
	handle /healthcheck {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Auth-User {http.auth.user.id}
			flush_interval -1
		}
	}
}
